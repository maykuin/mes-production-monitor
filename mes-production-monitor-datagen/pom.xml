<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mes.production.monitor</groupId>
        <artifactId>mes-production-monitor</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>mes-production-monitor-datagen</artifactId>
    <name>mes-production-monitor-datagen</name>
    <description>造数模块：backfill 历史回填 + streaming 持续实时 + 异常注入（见文档 9.3.1）</description>

    <properties>
        <job.main.class>com.mes.production.monitor.datagen.DataGenApp</job.main.class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.mes.production.monitor</groupId>
            <artifactId>mes-production-monitor-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>
        <!-- datagen 是普通 Java 应用，不跑在 Flink 上，日志实现要打进 jar。
             根因：common 里的 clickhouse-jdbc（classifier=shaded-all）把 slf4j-api 2.0.7 打进 fat jar 了
             （阴影包内嵌、Maven 排除不掉），所以绑定必须匹配 slf4j 2.x——用 slf4j-simple 2.0.7
             （提供 SLF4JServiceProvider），不能用 1.7.x 的 log4j-slf4j-impl（其 StaticLoggerBinder 会被 2.x 忽略）。 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.7</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
